{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JLshope12/jacob-shope-mortgage/blob/main/newsletter/issue.schema.json",
  "title": "Approved public-news-only newsletter issue",
  "description": "Everything in this payload is public repository content. Never include subscribers, customer data, credentials, internal notes, or individualized financial information. Runtime checks impose additional content, date, branding, and source requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "issue_date", "generated_at", "subject", "preview_text", "html", "plain_text", "public_news_only", "approved_for_delivery", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "issue_date": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "subject": {"type": "string", "minLength": 5, "maxLength": 180},
    "preview_text": {"type": "string", "minLength": 5, "maxLength": 250},
    "html": {"type": "string", "minLength": 200, "maxLength": 120000},
    "plain_text": {"type": "string", "minLength": 100, "maxLength": 60000},
    "public_news_only": {"const": true},
    "approved_for_delivery": {"const": true},
    "sources": {
      "type": "array", "minItems": 1, "maxItems": 30,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["url", "published_on", "checked_at"],
        "properties": {
          "url": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
          "published_on": {"type": "string", "format": "date"},
          "checked_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
